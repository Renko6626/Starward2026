# Starward2026 VPS runtime configuration.
#
#   cp .env.example .env && chmod 600 .env
#
# Fill in every empty value. Never commit `.env`; it is gitignored and excluded
# from the Docker build context. The Node runtime fails at startup with a named,
# value-free error when a required value is missing.

# --- Better Auth ----------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public HTTPS base URL. Must match SITE_ADDRESS below.
BETTER_AUTH_URL=https://starward.example.com
# Optional extra comma-separated trusted origins (e.g. a temporary domain).
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Resend transactional email ------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
RESEND_FROM_NAME=Starward2026

# --- Cloudflare Turnstile (optional; leave empty to disable) --------------
TURNSTILE_SECRET_KEY=

# --- SQLite ---------------------------------------------------------------
# Path inside the container. /app/data is the persistent `starward_data` volume.
SQLITE_PATH=/app/data/starward.sqlite
# Directory for timestamped backups. /app/backups is the `starward_backups` volume.
BACKUP_DIR=/app/backups

# --- VPS admin authorization ---------------------------------------------
# `better-auth` verifies a real Better Auth session whose email is in the
# allowlist. With an empty allowlist every /api/admin/* request returns 403
# (fail closed), so set at least one address before going live.
VPS_ADMIN_MODE=better-auth
VPS_ADMIN_EMAILS=

# --- Reverse proxy trust --------------------------------------------------
# The app is only reachable through Caddy on the compose network, so the
# immediate socket peer seen by the app is the Caddy container address.
# TRUSTED_PROXY_IPS is an exact match, not a CIDR range, and must equal that
# peer exactly. deploy/docker-compose.yml pins Caddy to 172.28.0.2; if you change
# the compose subnet or Caddy's ipv4_address, update this value to match.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=172.28.0.2

# --- Application submission rate limits (optional overrides) --------------
# Defaults: 6 submissions/IP/60s and 2 submissions/email/60s. A limit or window
# of 0 disables that bucket (the single-process limiter then no-ops).
# APPLICATION_SUBMIT_IP_RATE_LIMIT=6
# APPLICATION_SUBMIT_IP_RATE_LIMIT_WINDOW_SECONDS=60
# APPLICATION_SUBMIT_EMAIL_RATE_LIMIT=2
# APPLICATION_SUBMIT_EMAIL_RATE_LIMIT_WINDOW_SECONDS=60

# --- Caddy / TLS ----------------------------------------------------------
# Public hostname Caddy obtains a certificate for. DNS must already resolve
# here and ports 80/443 must be reachable. Use http://localhost for a local
# smoke test with no DNS or TLS.
SITE_ADDRESS=starward.example.com
# ACME account and certificate-expiry contact address.
ACME_EMAIL=admin@example.com
