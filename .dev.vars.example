# Copy this file to `.dev.vars` for local development (`.dev.vars` is gitignored).
# These values are read by `wrangler dev` / the local Vite worker and the
# db:local:* scripts. Never commit real secrets, and never set the dev-only
# flags below in staging/production wrangler config.

# Signs the local Better Auth session cookies emitted by db:local:reset.
BETTER_AUTH_SECRET="replace-with-a-32-plus-character-local-secret"
BETTER_AUTH_URL="http://localhost:20262"

# Admin pages use the same verified website sessions as production.
# Grant a local test user a role in admin_roles after applying migrations.
# ALLOW_LOCAL_ADMIN_BYPASS and x-admin-email no longer grant access.

# Dev-only origin trust. When "true", Better Auth dynamically trusts loopback /
# private-network (localhost, *.localhost, 127.x, 10.x, 192.168.x, 172.16-31.x)
# request origins so multi-port local setups pass the CSRF/origin check.
# Leave unset in deployed environments; list real origins via
# BETTER_AUTH_TRUSTED_ORIGINS instead.
ALLOW_LOCAL_DEV_ORIGINS="true"

# Turnstile is off when the Worker secret is absent. For local testing, put a
# matching public test site key in `.env.local` as VITE_TURNSTILE_SITE_KEY and
# its test secret in `.dev.vars`; production secrets belong in Cloudflare.
# TURNSTILE_SECRET_KEY="replace-with-turnstile-secret"

# Comma/newline separated list of additional trusted origins (all environments).
# BETTER_AUTH_TRUSTED_ORIGINS="https://dev.example.com"

# QQ website OAuth; keep disabled until the application and callback are configured.
QQ_OAUTH_ENABLED="false"
# QQ_APP_ID="your-qq-website-app-id"
# QQ_APP_KEY="configure-server-side-only"
