{
  "name": "starward2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "miniflare": {
      "undici": "7.24.8"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:staging": "CLOUDFLARE_ENV=staging npm run build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging npm run build && CLOUDFLARE_ENV=staging wrangler deploy",
    "db:local:reset": "node ./scripts/local-dev-bootstrap.mjs bootstrap",
    "db:local:seed": "node ./scripts/local-dev-bootstrap.mjs seed",
    "db:local:print-portals": "node ./scripts/local-dev-bootstrap.mjs print",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "test:env": "node ./scripts/test-env.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:headed": "node scripts/e2e.mjs --headed",
    "cf-typegen": "wrangler types",
    "check": "tsc -b --pretty false",
    "check:production": "node scripts/production-deploy.mjs",
    "test:deploy": "node --test scripts/production-deploy.test.mjs scripts/production-database.test.mjs",
    "test": "vitest run",
    "station:assets": "node scripts/station-assets.mjs",
    "station:check": "node scripts/station-assets.mjs --check",
    "station:update": "npm run station:generate && npm run build",
    "test:station": "node --test scripts/station-assets.test.mjs scripts/station-drawings.test.mjs scripts/station-batches.test.mjs",
    "prebuild": "npm run station:check && npm run station:drawings:check && npm run orbit:check",
    "orbit:generate": "node scripts/orbit-assets.mjs",
    "orbit:check": "node scripts/orbit-assets.mjs --check",
    "orbit:update": "npm run orbit:generate && npm run build",
    "test:orbit": "python3 -m unittest discover -s scripts/orbit-transfer -p 'test_*.py'",
    "station:drawings": "node experiments/station/technical-study/capture.mjs",
    "station:drawings:check": "node experiments/station/technical-study/capture.mjs --check",
    "station:generate": "npm run station:assets && npm run station:drawings"
  },
  "dependencies": {
    "@better-auth/core": "^1.6.2",
    "@tanstack/react-router": "^1.133.28",
    "better-auth": "^1.6.2",
    "clsx": "^2.1.1",
    "hono": "^4.12.12",
    "jose": "^6.2.2",
    "lucide-react": "^0.546.0",
    "motion": "^13.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.10.0",
    "tailwind-merge": "^3.3.1",
    "three": "0.180.0",
    "vivus": "0.4.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/router-plugin": "^1.133.28",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "@types/vivus": "^0.4.7",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.81.1"
  }
}
