{
  "name": "starward2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:staging": "CLOUDFLARE_ENV=staging npm run build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging npm run build && CLOUDFLARE_ENV=staging wrangler deploy",
    "db:local:reset": "node ./scripts/local-dev-bootstrap.mjs bootstrap",
    "db:local:seed": "node ./scripts/local-dev-bootstrap.mjs seed",
    "db:local:print-portals": "node ./scripts/local-dev-bootstrap.mjs print",
    "cf-typegen": "wrangler types",
    "check": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@tanstack/react-router": "^1.133.28",
    "better-auth": "^1.6.2",
    "clsx": "^2.1.1",
    "hono": "^4.12.12",
    "jose": "^6.2.2",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.10.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/router-plugin": "^1.133.28",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.81.1"
  }
}
