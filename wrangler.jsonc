/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starward2026",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-10",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "QQ_OAUTH_ENABLED": "false" },
  "ratelimits": [
    {
      "name": "APPLICATION_SUBMIT_IP_RATE_LIMITER",
      "namespace_id": "2026041101",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "APPLICATION_SUBMIT_EMAIL_RATE_LIMITER",
      "namespace_id": "2026041102",
      "simple": {
        "limit": 2,
        "period": 60
      }
    },
    {
      "name": "AUTH_OTP_IP_RATE_LIMITER",
      "namespace_id": "2026101101",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "AUTH_OTP_EMAIL_RATE_LIMITER",
      "namespace_id": "2026101102",
      "simple": { "limit": 1, "period": 60 }
    }
  ],
  /**
   * Set these when the actual Cloudflare resources are created:
   * - D1 database binding
   * - Better Auth secret
   * - Better Auth base URL
   * - Bootstrap the admin owner after applying the admin_roles migration
   * - Resend API key and sender
   * - Turnstile secret
   * - Replace the rate limit namespace ids if they collide with existing account-level values
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starward2026",
      "database_id": "217b5fbf-1865-4b20-8551-85349f53b349"
    }
  ],
  "env": {
    "staging": {
      "ratelimits": [
        {
          "name": "APPLICATION_SUBMIT_IP_RATE_LIMITER",
          "namespace_id": "2026041101",
          "simple": {
            "limit": 6,
            "period": 60
          }
        },
        {
          "name": "APPLICATION_SUBMIT_EMAIL_RATE_LIMITER",
          "namespace_id": "2026041102",
          "simple": {
            "limit": 2,
            "period": 60
          }
        },
        {
          "name": "AUTH_OTP_IP_RATE_LIMITER",
          "namespace_id": "2026101101",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "AUTH_OTP_EMAIL_RATE_LIMITER",
          "namespace_id": "2026101102",
          "simple": { "limit": 1, "period": 60 }
        }
      ],
      "routes": [
        {
          "pattern": "hifuu-staging.mucwiki-edge.link",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "starward2026",
          "database_id": "217b5fbf-1865-4b20-8551-85349f53b349"
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://hifuu-staging.mucwiki-edge.link",
        "QQ_OAUTH_ENABLED": "false"
      }
    },
    "production": {
      "name": "starward2026-production",
      // Production uses separate namespaces from local/staging.
      "ratelimits": [
        { "name": "APPLICATION_SUBMIT_IP_RATE_LIMITER", "namespace_id": "2026041103", "simple": { "limit": 6, "period": 60 } },
        { "name": "APPLICATION_SUBMIT_EMAIL_RATE_LIMITER", "namespace_id": "2026041104", "simple": { "limit": 2, "period": 60 } },
        { "name": "AUTH_OTP_IP_RATE_LIMITER", "namespace_id": "2026101103", "simple": { "limit": 10, "period": 60 } },
        { "name": "AUTH_OTP_EMAIL_RATE_LIMITER", "namespace_id": "2026101104", "simple": { "limit": 1, "period": 60 } }

      ],
      // Named environments do NOT inherit the top-level bindings, so the
      // production D1 binding must be declared explicitly here or every
      // DB-backed endpoint returns 503 after a production deploy.
      // CI resolves this placeholder by database_name, creating the dedicated DB if absent.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "starward2026-prod",
          "database_id": "800d3172-7b0c-4676-9eee-ea94decb6f81"
        }
      ],
      "routes": [{ "pattern": "hifuu.moe", "custom_domain": true }],
      "vars": {
        "BETTER_AUTH_URL": "https://hifuu.moe",
        "RESEND_FROM_EMAIL": "noreply@hifuu.moe",
        "RESEND_FROM_NAME": "逐星巡礼",
        "QQ_OAUTH_ENABLED": "false"
      }
      // The production tag workflow validates these settings before deployment.
    }
  },
  // "vars": {
  //   "BETTER_AUTH_SECRET": "replace-with-32-plus-char-secret",
  //   "BETTER_AUTH_URL": "https://your-app.example.com",
  //   "RESEND_API_KEY": "re_xxxxxxxxx",
  //   "RESEND_FROM_EMAIL": "noreply@example.com",
  //   "RESEND_FROM_NAME": "Starward2026",
  //   "TURNSTILE_SECRET_KEY": "replace-with-real-turnstile-secret"
  // }
}
