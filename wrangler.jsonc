/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starward2026",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-10",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "QQ_OAUTH_ENABLED": "false" },
  "ratelimits": [
    {
      "name": "APPLICATION_SUBMIT_IP_RATE_LIMITER",
      "namespace_id": "2026041101",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "APPLICATION_SUBMIT_EMAIL_RATE_LIMITER",
      "namespace_id": "2026041102",
      "simple": {
        "limit": 2,
        "period": 60
      }
    }
  ],
  /**
   * Set these when the actual Cloudflare resources are created:
   * - D1 database binding
   * - Better Auth secret
   * - Better Auth base URL
   * - Cloudflare Access team domain and policy aud for /api/admin verification
   * - Resend API key and sender
   * - Turnstile secret
   * - Replace the rate limit namespace ids if they collide with existing account-level values
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starward2026",
      "database_id": "217b5fbf-1865-4b20-8551-85349f53b349"
    }
  ],
  "env": {
    "staging": {
      "ratelimits": [
        {
          "name": "APPLICATION_SUBMIT_IP_RATE_LIMITER",
          "namespace_id": "2026041101",
          "simple": {
            "limit": 6,
            "period": 60
          }
        },
        {
          "name": "APPLICATION_SUBMIT_EMAIL_RATE_LIMITER",
          "namespace_id": "2026041102",
          "simple": {
            "limit": 2,
            "period": 60
          }
        }
      ],
      "routes": [
        {
          "pattern": "hifuu-staging.mucwiki-edge.link",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "starward2026",
          "database_id": "217b5fbf-1865-4b20-8551-85349f53b349"
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://hifuu-staging.mucwiki-edge.link",
        "QQ_OAUTH_ENABLED": "false"
      }
    },
    "production": {
      // Named environments do NOT inherit the top-level bindings, so the
      // production D1 binding must be declared explicitly here or every
      // DB-backed endpoint returns 503 after a production deploy.
      // Replace database_id with the real production D1 id before deploying.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "starward2026-prod",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID"
        }
      ],
      // Replace with the real production URL before the first production deploy.
      "vars": {
        "BETTER_AUTH_URL": "https://replace-with-production-domain.example.com",
        "QQ_OAUTH_ENABLED": "false"
      }
      // Add production routes before enabling deploy:production.
    }
  },
  // "vars": {
  //   "BETTER_AUTH_SECRET": "replace-with-32-plus-char-secret",
  //   "BETTER_AUTH_URL": "https://your-app.example.com",
  //   "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://your-team.cloudflareaccess.com",
  //   "CLOUDFLARE_ACCESS_POLICY_AUD": "replace-with-your-access-application-aud",
  //   "RESEND_API_KEY": "re_xxxxxxxxx",
  //   "RESEND_FROM_EMAIL": "noreply@example.com",
  //   "RESEND_FROM_NAME": "Starward2026",
  //   "TURNSTILE_SECRET_KEY": "replace-with-real-turnstile-secret"
  // }
}
